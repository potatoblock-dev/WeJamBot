# OpenAI-compatible LLM. Fill locally; never commit real values.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=YOUR_API_KEY
LLM_MODEL=deepseek-flash
# LLM_TIMEOUT_SECONDS=25
# MEMORY_MAX_TURNS=12

# Archive LLM (impression / group culture / prompt evolution). Blank = same as LLM_*.
# ARCHIVE_LLM_BASE_URL=
# ARCHIVE_LLM_API_KEY=
# ARCHIVE_LLM_MODEL=

# Bridge gRPC target (wejam.v1). 日常唯一：Callus GUI（可进个人群）:
WEJAM_TARGET=127.0.0.1:7701
# openclaw :7702 / WeJam :7700 仅归档，勿作默认
