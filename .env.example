# OpenAI-compatible LLM. Fill locally; never commit real values.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=YOUR_API_KEY
LLM_MODEL=deepseek-flash
# LLM_TIMEOUT_SECONDS=25
# MEMORY_MAX_TURNS=12

# Bridge gRPC target (wejam.v1). Prefer Callus openclaw non-GUI:
# WEJAM_TARGET=127.0.0.1:7702
# Legacy GUI: WeJam :7700 / Callus capture :7701
# WEJAM_TARGET=127.0.0.1:7700
# BOT_NAME=bot
# COALESCE_BURST_SECONDS=30
# COALESCE_DEBOUNCE_SECONDS=3
# ALLOW_CHATS_PATH=./data/allow_chats.txt
# REPLY_POLICY_PATH=./reply_policy.toml
# PERSONAS_DIR=./data/personas
# PERSONAS_INDEX_PATH=./personas.toml
